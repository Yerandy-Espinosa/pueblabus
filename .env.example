# Public CTAN/CTAS sources and OpenStreetMap do not need credentials.
PORT=3001
# Official GPS with labeled timetable estimates is the default after npm run data:sync.
# Set only to explicitly show synthetic demo data:
# TRANSIT_MODE=demo
# Optional alternate normalized HTTPS GPS provider. Not needed for CTAS:
# TRANSIT_FEED_URL=https://operator.example/api/pueblabus
